{
  "name": "kando-mcp",
  "version": "0.4.1",
  "description": "MCP server for the Kando Kanban board — read and edit tickets from Claude Code.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "kando-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "commands",
    "assets",
    "kando.config.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "amazon-cognito-identity-js": "^6.3.12",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^22.0.0"
  }
}
