# ---------------------------------------------------------------------------
# .env.test.local — credentials for the live e2e test (src/live.e2e.test.ts).
#
# Copy to `.env.test.local` (gitignored) and fill in. Real environment variables
# always win over this file, so CI can supply the same names as secrets without
# any code change.
#
# The test is skipped entirely unless KANDO_LIVE=1:
#
#     KANDO_LIVE=1 npx vitest run src/live.e2e.test.ts
#
# WHICH stage it targets is NOT set here. By default it is the Dev stage, from
# the committed `kando.config.dev.json`. To aim it at your own stage instead,
# set all four KANDO_TEST_ target variables below — all of them or none. A
# partial set is refused, loudly: it would otherwise sign in to one stage's
# Cognito pool and write through another's API.
# ---------------------------------------------------------------------------

# --- Required. An account that exists in the target stage's pool. ------------
KANDO_TEST_EMAIL=
KANDO_TEST_PASSWORD=

# --- Optional. Override the Dev default with another stage. All four or none. -
# KANDO_TEST_REGION=eu-central-1
# KANDO_TEST_POOL_ID=eu-central-1_...
# KANDO_TEST_CLIENT_ID=...
# KANDO_TEST_GRAPHQL_URL=https://....appsync-api.eu-central-1.amazonaws.com/graphql

# --- The production escape hatch. Leave this unset. --------------------------
# The resolver refuses the hosted production pool however it was supplied. This
# overrides that. The test creates and deletes real boards; in production they
# are real boards nothing else sweeps up.
# KANDO_ALLOW_PROD=1
